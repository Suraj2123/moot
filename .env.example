# Copy to .env and fill in. .env is gitignored -- never commit real tokens.

# --- Canvas ---------------------------------------------------------------
# Base URL of your institution's Canvas, with no trailing path.
CANVAS_API_URL=https://canvas.yourschool.edu
# Account -> Settings -> "+ New Access Token". Treat like a password.
CANVAS_API_TOKEN=

# --- Embeddings -----------------------------------------------------------
# One of: hash | voyage | sentence-transformers
# Defaults to `voyage` if VOYAGE_API_KEY is set, otherwise `hash`.
# `hash` is a deterministic offline lexical baseline -- the app and the eval
# both run with no keys at all, which is what makes the demo reproducible.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=
VOYAGE_API_KEY=

# --- Agent ----------------------------------------------------------------
# Needed only for the work-session agent and the LLM judge. Retrieval and the
# metrics work without it.
ANTHROPIC_API_KEY=

# --- Retrieval tuning -----------------------------------------------------
# Defaults; the sidebar and `scripts/run_eval.py --sweep` can override these.
CHUNK_SIZE=180
CHUNK_OVERLAP=40
TOP_K=5
SCORE_THRESHOLD=0.15

# --- Storage --------------------------------------------------------------
# STUDYLINK_DB=data/studylink.db
# STUDYLINK_LABELS=data/eval/labels.json
#
# Full SQLAlchemy URL. Set this to run on Postgres; leave it unset and the app
# falls back to the SQLite file above.
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/studylink
#
# Width of the native pgvector column, fixed when migration 0002 runs. pgvector
# needs a declared dimension to index on, so changing embedding provider (the
# hash baseline is 256, voyage-3 is 1024) means writing a migration that alters
# the column -- it is not a config change you can make on a live database.
# EMBEDDING_DIM=256
#
# How many candidates the HNSW index keeps while searching. Higher trades
# latency for recall. pgvector's default is 40; this is raised because the
# embeddings table is multi-tenant and the tenant filter discards candidates
# after the index produces them.
# HNSW_EF_SEARCH=100
