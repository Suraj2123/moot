# Copy to .env and fill in. .env is gitignored -- never commit real tokens.

# --- Canvas ---------------------------------------------------------------
# Base URL of your institution's Canvas, with no trailing path.
CANVAS_API_URL=https://canvas.yourschool.edu
# Account -> Settings -> "+ New Access Token". Treat like a password.
CANVAS_API_TOKEN=

# --- Embeddings -----------------------------------------------------------
# One of: hash | voyage | sentence-transformers
# Defaults to `voyage` if VOYAGE_API_KEY is set, otherwise `hash`.
# `hash` is a deterministic offline lexical baseline -- the app and the eval
# both run with no keys at all, which is what makes the demo reproducible.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=
VOYAGE_API_KEY=

# --- Agent ----------------------------------------------------------------
# Needed only for the work-session agent and the LLM judge. Retrieval and the
# metrics work without it.
ANTHROPIC_API_KEY=

# --- Retrieval tuning -----------------------------------------------------
# Defaults; the sidebar and `scripts/run_eval.py --sweep` can override these.
CHUNK_SIZE=180
CHUNK_OVERLAP=40
TOP_K=5
SCORE_THRESHOLD=0.15

# --- Storage --------------------------------------------------------------
# STUDYLINK_DB=data/studylink.db
# STUDYLINK_LABELS=data/eval/labels.json
