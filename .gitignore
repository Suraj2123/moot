# Secrets
.env

# Local database -- rebuildable from Canvas or scripts/seed_demo.py.
# data/eval/labels.json is NOT ignored: the label set is the slowest artefact
# in the project to recreate and belongs in version control.
data/*.db
data/*.db-wal
data/*.db-shm

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/

# Editors / OS
.DS_Store
.idea/
.vscode/

# Alembic
alembic/versions/__pycache__/

# Frontend
node_modules/
web/node_modules/
web/dist/
web/tsconfig.tsbuildinfo

# Build output. The Dockerfile builds it in its own stage, run.sh builds it
# if missing, and the filenames are content-hashed -- so tracking it meant
# every one-line style change shipped two minified blobs and a rename.
studylink/static/
.secret_key
